<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground = the connect-button glyph (white flame over a base line).
     Same path data as ic_notification, scaled x3.15 from the 24-grid into the
     adaptive-icon safe zone (inner 66dp circle of the 108dp canvas). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- glyph bbox on 24-grid: x[7..17], y[2..21], center (12, 11.5)
         transform: (x,y) -> (x*3.15 + 16.2, y*3.15 + 17.775) so the glyph
         lands centered on (54,54) spanning ~60dp of the 66dp safe circle -->
    <group
        android:scaleX="3.15"
        android:scaleY="3.15"
        android:translateX="16.2"
        android:translateY="17.775">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M12,2 C14.2,5.2 17,7.6 17,11 C17,14.4 14.8,17 12,17 C9.2,17 7,14.4 7,11 C7,9.6 7.6,8.4 8.6,7.2 C8.4,9 9,10.3 10,10.9 C9.2,8.6 10.2,4.9 12,2 Z M8,19 L16,19 C16.6,19 17,19.4 17,20 C17,20.6 16.6,21 16,21 L8,21 C7.4,21 7,20.6 7,20 C7,19.4 7.4,19 8,19 Z" />
    </group>
</vector>
